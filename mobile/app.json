{
  "expo": {
    "name": "Scam Guardian",
    "slug": "scam-guardian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "scamguardian",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1B1C1F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "az.yunex.scamguardian",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Scam Guardian records your voice only when you tap Record, to check a suspicious sentence."
      }
    },
    "android": {
      "package": "az.yunex.scamguardian",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B3D91",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Scam Guardian records your voice only when you tap Record, to check a suspicious sentence.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B3D91",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1F45"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withWebAssets",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
