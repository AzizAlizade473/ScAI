   "persona": "invest",
   "lines": [
    {
     "who": "caller",
     "text": "Alo, salam. \"Xəzər Enerji İnvest\"dən Kamran Əliyev sizi narahat edir, salamlayıram sizi. Təbrik edirəm, dövlət proqramına seçilmisiniz.",
     "at": 10440,
     "source": "gemini-3.8-live (ASR)",
     "cut": false
    },
    {
     "who": "you",
     "text": "Hans Radcliffe",
     "at": 14134,
     "source": "gemini-3.8-live (ASR)",
     "cut": false
    },
    {
     "who": "caller",
     "text": "Baxın, üç yüz manatlıq ilkin depozit qoymaqla, ayda iki min manata yaxın gəlir əldə edə bilərsiniz. Bu, dövlət tərəfindən zəmanətlidir.",
     "at": 22618,
     "source": "gemini-3.8-live (ASR)",
     "cut": false
    },
    {
     "who": "you",
     "text": "Doğrudan bu necə işləyir?",
     "at": 28452,
     "source": "gemini-3.8-live (ASR)",
     "cut": false
    },
    {
     "who": "caller",
     "text": "Biz neft və qaz sektorunun gəlirlərini sizin kimi vətəndaşlarla bölüşürük. Dövlət zəmanəti ilə risksiz qazanc əldə edirsiniz.",
     "at": 36264,
     "source": "gemini-3.8-live (ASR)",
     "cut": false
    },
    {
     "who": "you",
     "text": "İlham uşaqlarla məsləhətləşin.",
     "at": 41484,
     "source": "gemini-3.8-live (ASR)",
     "cut": false
    },
    {
     "who": "caller",
     "text": "Başa düşürəm, amma yerlər çox azdır və bu təklif yalnız bu gün üçün keçərlidir. Geciksəniz, şansı əldən verəcəksiniz.",
     "at": 48974,
     "source": "gemini-3.8-live (ASR)",
     "cut": false
    }
   ],
