  "talk": {
   "ranAt": "2026-11-08T11:13:13.164Z",
   "name": "multi-turn conversation (bank)",
   "persona": "bank",
   "lines": [
    {
     "who": "caller",
     "text": "Salam, Abşeron Kredit Bankdan narahat edirəm, təhlükəsizlik şöbəsindən Elvin Quliyevəm. Baxın, kartınızdan Gəncədəki bir mağazaya min iki yüz əlli manatlıq ödəniş olunur. Bu əməliyyatı siz təsdiqləyirsiniz?",
     "at": 14729,
     "source": "gemini-3.8-live (Live ASR)",
     "cut": false
    },
    {
     "who": "you",
     "text": "Salam, buyurun, eşidirəm.",
     "at": 20626,
     "source": "gemini-3.5-transcribe (STT)",
     "cut": false
    },
    {
     "who": "caller",
     "text": "Baxın, bu ödəniş sizə aid deyilsə, vəsaitinizi qorumaq üçün kartı dərhal bloklamalıyıq. Xahiş edirəm, narahat olmayın, hər şeyi həll edəcəyik.",
     "at": 27656,
     "source": "gemini-3.8-live (Live ASR)",
     "cut": false
    },
    {
     "who": "you",
     "text": "Aman Allah, mən heç nə almamışam.",
     "at": 34520,
     "source": "gemini-3.5-transcribe (STT)",
     "cut": false
    },
    {
     "who": "caller",
     "text": "Başa düşürəm, narahat olmayın, biz vəsaitinizi qoruyacağıq. Zəhmət olmasa, identifikasiya üçün kart nömrənizi qeyd edərdiniz? Son rəqəmləri görürəm, amma tam nömrə lazımdır.",
     "at": 42986,
     "source": "gemini-3.8-live (Live ASR)",
     "cut": false
    },
    {
     "who": "you",
     "text": "Niye yani? Onunla danışabilirem mi?",
     "at": 51212,
     "source": "gemini-3.5-transcribe (STT)",
     "cut": false
    },
    {
     "who": "caller",
     "text": "Narahat olmayın, bu prosedur yalnız sizin təhlükəsizliyiniz üçündür. Zəhmət olmasa, kart nömrəsini bildirin ki, əməliyyatı dayandıraq və vəsaitinizi qoruyaq.",
     "at": 57732,
     "source": "gemini-3.8-live (Live ASR)",
     "cut": false
    },
    {
     "who": "you",
     "text": "Bilmirəm, uşaqlarla məsləhətləşin.",
     "at": 64586,
     "source": "gemini-3.5-transcribe (STT)",
     "cut": false
    },
    {
     "who": "caller",
     "text": "Vaxtımız çox azdır, məsləhətləşməyə vaxt yoxdur. Bir neçə dəqiqəyə bütün vəsaitinizi itirə bilərsiniz, təcili hərəkət etməliyik.",
     "at": 69874,
     "source": "gemini-3.8-live (Live ASR)",
     "cut": false
    },
    {
     "who": "you",
     "text": "Bir dakika, kartı tapın.",
     "at": 76152,
     "source": "gemini-3.5-transcribe (STT)",
     "cut": false
    },
    {
     "who": "caller",
     "text": "Nömrəni qeyd etdim, indi telefonunuza bir kod gələcək, onu mənə deyin zəhmət olmasa. Əks halda pulunuz batacaq.",
     "at": 79862,
     "source": "gemini-3.8-live (Live ASR)",
     "cut": false
    }
   ],
