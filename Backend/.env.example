# Copy this file to Backend/.env and fill it in:   cp .env.example .env
# Backend/.env is the ONLY place for keys and passwords. It is git-ignored; never commit it.

# --- Gemini (scam analysis, speech-to-text, text-to-speech) -------------------------------
# Key from https://aistudio.google.com/apikey. Empty = the rules engine still works, AI is off.
GEMINI_API_KEY=
# Optional: one model or a comma-separated list (fastest first). Empty = the app's default.
GEMINI_MODEL=

# --- MySQL --------------------------------------------------------------------------------
# Pick your own long random passwords. They are set on the FIRST start only (empty volume).
MYSQL_ROOT_PASSWORD=
MYSQL_APP_USER=yunex_app
MYSQL_APP_PASSWORD=
MYSQL_PIPELINE_USER=yunex_pipeline
MYSQL_PIPELINE_PASSWORD=

# --- Ports on your laptop -----------------------------------------------------------------
APP_PORT=8787
MYSQL_PORT=3306
ADMINER_PORT=8081

# --- Pipeline -----------------------------------------------------------------------------
# 0 = run once on `docker compose up` and stop. 1440 = run once a day (set it after the source updates).
PIPELINE_EVERY_MINUTES=0
# Optional government scam-number API (JSON pages: {"items": [...], "next": "<url or null>"}).
GOV_SCAM_API_URL=
GOV_SCAM_API_TOKEN=
